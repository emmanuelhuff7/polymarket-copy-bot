# ── Trading Logic ──────────────────────────────────────────────
CONSENSUS_THRESHOLD=2
TRACKED_TRADER_COUNT=5
POSITION_SIZE_USD=27.50
ACCOUNT_CAPITAL_USD=1500.00
MAX_OPEN_POSITIONS=10
DAILY_LOSS_LIMIT_USD=75.00
MIN_MARKET_VOLUME_USD=50000.00
SIGNAL_WINDOW_SECONDS=300
MARKETS_SKIP_LIST=

# ── Polling ─────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=30
LEADERBOARD_REFRESH_CRON=rate(6 hours)

# ── Polymarket ──────────────────────────────────────────────────
POLYMARKET_HOST=https://clob.polymarket.com
DATA_API_BASE=https://data-api.polymarket.com
GAMMA_API_BASE=https://gamma-api.polymarket.com
POLYGON_RPC_URL=https://polygon-rpc.com

# ── AWS ─────────────────────────────────────────────────────────
AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/polymarket-bot-trades.fifo
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:polymarket-bot-alerts
DYNAMO_TABLE_PREFIX=polymarket-bot
SECRETS_MANAGER_KEY_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:polymarket-bot/eoa-key
SECRETS_MANAGER_CREDS_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:polymarket-bot/api-creds

# ── Alerts ──────────────────────────────────────────────────────
ALERT_EMAIL=your-email@example.com
ALERT_PHONE=+15551234567

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
